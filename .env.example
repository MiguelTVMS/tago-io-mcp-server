# Example environment file for Docker deployment
# Copy this file to .env and update with your values

# ========================================
# TagoIO Configuration (Required)
# ========================================

# Required: TagoIO API token (Profile or Analysis token)
TAGOIO_TOKEN=your_tagoio_token_here

# Optional: TagoIO API endpoint (defaults to US region)
TAGOIO_API=https://api.us-e1.tago.io

# ========================================
# MCP Generic Server Configuration
# ========================================

# Optional: Log level for the MCP server (debug, info, warn, error)
MCP_SERVER_LOG_LEVEL=info

# Optional: Log format for the MCP server (plain, json, gcp-json)
MCP_SERVER_LOG_FORMAT=plain

# Optional: Whether to start the HTTP server instead of stdio (true, false)
MCP_SERVER_USE_HTTP=false

# Optional: Whether to maintain stateful sessions per client (true, false)
MCP_SERVER_STATEFUL=false

# ========================================
# MCP Server HTTP Configuration
# (Only used when MCP_SERVER_USE_HTTP=true)
# ========================================

# Optional: Port for the HTTP/SSE server
MCP_HTTP_PORT=3000

# Optional: Host for the HTTP/SSE server
MCP_HTTP_HOST=0.0.0.0

# Optional: Base path for MCP HTTP endpoints
MCP_HTTP_PATH=/mcp

# Optional: Enable a healthcheck endpoint (true, false)
MCP_HTTP_ENABLE_HEALTHCHECK=true

# Optional: Path for the healthcheck endpoint
MCP_HTTP_HEALTHCHECK_PATH=/healthz

# Optional: Enable CORS for the HTTP server (true, false)
MCP_HTTP_ALLOW_CORS=true

# Optional: Comma-separated list of allowed hosts for requests
# MCP_HTTP_ALLOWED_HOSTS=localhost,example.com

# Optional: Comma-separated list of allowed origins for CORS
# MCP_HTTP_ALLOWED_ORIGINS=http://localhost:3000,https://example.com

# Optional: Whether to use ngrok to expose the HTTP server publicly (true, false)
MCP_HTTP_NGROK_ENABLED=false

# Optional: ngrok auth token (required if MCP_HTTP_NGROK_ENABLED=true)
# MCP_HTTP_NGROK_AUTH_TOKEN=your_ngrok_auth_token

# ========================================
# Additional Configuration
# ========================================

# Optional: Node environment (development, production, test)
# NODE_ENV=production

# Optional: Log level for debugging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Test mode flag
# TEST=true
